<?xml version="1.0" encoding="UTF-8"?>
<!-- nightshift launchd agent (macOS). Adjust the paths, then:
     cp com.nightshift.nightly.plist ~/Library/LaunchAgents/
     launchctl load ~/Library/LaunchAgents/com.nightshift.nightly.plist
     A run missed while the Mac was asleep is started at wake-up. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.nightshift.nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/opt/nightshift/nightly/runner.mjs</string>
    <string>--vault</string>
    <string>/Users/you/notes</string>
    <string>--backup</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>5</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>StandardOutPath</key><string>/Users/YOU/Library/Logs/nightshift/out.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/Library/Logs/nightshift/err.log</string>
</dict>
</plist>
